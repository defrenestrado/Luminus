# Chave da API da DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Narrador de emergencia via DeepSeek (so entra se todas as rotas locais
# falharem: Ollama fora, CUDA envenenado, GPUs perdidas). Requer a chave acima.
LUMINUS_DEEPSEEK_FALLBACK=1
LUMINUS_DEEPSEEK_MODEL=deepseek-flash
LUMINUS_DEEPSEEK_THINKING=0
# 0 = sem limite; ex.: 10 para parar o fallback ao gastar US$ 10 no processo.
# O acumulado fica em logs/deepseek_usage.jsonl e em /api/health.
LUMINUS_DEEPSEEK_BUDGET_USD=0

# Gerador de imagem. O padrão gratuito é o Pollinations (sem chave).
# Modelo gratuito: sana. Se você tiver uma pollen key, configure o modelo pago.
LUMINUS_ART_PROVIDER=pollinations
LUMINUS_ART_URL=https://image.pollinations.ai/prompt
LUMINUS_ART_MODEL=
POLLINATIONS_TOKEN=
LUMINUS_ART_WIDTH=768
LUMINUS_ART_HEIGHT=1024
LUMINUS_ART_COOLDOWN=45

# ComfyUI local (provider=comfyui). O worker primario roda na GPU2 (RTX 2060)
# e e iniciado/parado pelo servidor. LUMINUS_COMFY_POOL lista workers extras
# no formato url@gpu@unit: sao usados quando ja estao de pe e nunca sao
# parados pelo servidor (ligue/desligue com scripts/comfy_gpu.sh).
LUMINUS_COMFY_URL=http://127.0.0.1:8188
LUMINUS_COMFY_SERVICE=luminus-comfy
LUMINUS_COMFY_GPU=2
LUMINUS_COMFY_POOL=
# 1 = sobe um worker do pool automaticamente quando o Ollama esta ocioso.
LUMINUS_COMFY_AUTOSTART=0
# 1 = libera a VRAM do worker depois de cada imagem (deixa o Narrador
# voltar a usar a placa). Use 0 em lotes paralelos.
LUMINUS_COMFY_FREE_AFTER=1
LUMINUS_COMFY_ATTEMPTS=2

# Seguranca de GPU (failover de modelo)
LUMINUS_MODEL_FULL=luminus-27b
LUMINUS_MODEL_2GPU=qwen38-9b-heretic:latest
LUMINUS_MODEL_1GPU=qwen38-9b-heretic-q5
LUMINUS_MODEL_UTILITY=qwen38-9b-heretic-q5
LUMINUS_MODEL_CPU=qwen38-9b-heretic-q5
LUMINUS_EXPECTED_MAIN_GPUS=3
LUMINUS_EXPECTED_UTILITY_GPUS=1
LUMINUS_GPU_MAIN_MATCH="3060 Ti"
LUMINUS_GPU_UTILITY_MATCH="2060"
LUMINUS_PRIMARY_MIN_GPUS=3
LUMINUS_CTX_2GPU=16384
LUMINUS_CTX_1GPU=8192
LUMINUS_GPU_POLL_SECONDS=20
LUMINUS_GPU_FAILURE_THRESHOLD=2
LUMINUS_GPU_RECOVERY_THRESHOLD=3
LUMINUS_GPU_FAILURE_COOLDOWN=900

# Features narrativas novas (1=ligado). Desligue para voltar ao fluxo antigo.
LUMINUS_RESOLUTION=1
LUMINUS_OFFSCREEN=1
LUMINUS_VOICES=1
LUMINUS_OFFSCREEN_EVERY=4
LUMINUS_VOICES_EVERY=6
# Qualidade/reliability da narracao
LUMINUS_NARRATION_TOKENS=1000
LUMINUS_NARRATION_CONTINUATIONS=2
LUMINUS_CHAT_IDEMPOTENCY_WINDOW=180
LUMINUS_LOGIC_REVIEW=1
LUMINUS_LOGIC_REVIEW_TIMEOUT=45
LUMINUS_GUARD_REWRITE=1
LUMINUS_GUARD_REWRITE_TIMEOUT=45
# Diretorio gravavel pelo app onde o helper root le pedidos de reinicio
LUMINUS_GPU_RESTART_DIR=/var/lib/luminus-gpu-guard

# NPCs: criacao profunda (Pensador -> Juiz -> Sintese), inspirada no freellmpool.
# O pool e um endpoint OpenAI-compatible com failover. Se LUMINUS_NPC_POOL_URL
# estiver vazio, usa DeepSeek (se ativado) ou a GPU utilitaria local.
LUMINUS_NPC_DEEP=1
LUMINUS_NPC_JUDGE=1
LUMINUS_NPC_POOL_URL=
LUMINUS_NPC_POOL_KEY=
LUMINUS_NPC_POOL_MODEL=quality
LUMINUS_NPC_POOL_TASK=general
LUMINUS_NPC_USE_DEEPSEEK=0
LUMINUS_NPC_DEEPSEEK_MODEL=deepseek-chat
LUMINUS_NPC_ALLOW_CPU=0
LUMINUS_NPC_ALLOW_MAIN=0
LUMINUS_NPC_STAGE_TIMEOUT=90
# Pool: tentativas por etapa e limite de UMA chamada (o freellmpool ja faz
# failover interno; a segunda tentativa cobre 404/429 transitorios).
LUMINUS_NPC_POOL_ATTEMPTS=2
LUMINUS_NPC_POOL_TIMEOUT=75
# Depois do 1o dossie valido, tolerancia para os demais Pensadores; os lentos
# sao cancelados para nao segurar a criacao inteira.
LUMINUS_NPC_THINKER_GRACE=8

# Watchdog do Narrador: evita que o app fique pendurado quando o llama-server
# morre no meio do turno. Primeiro token pode demorar (carga do modelo);
# depois do primeiro byte, silencio maior que o idle e tratado como falha.
LUMINUS_STREAM_FIRST_TIMEOUT=300
LUMINUS_STREAM_IDLE_TIMEOUT=60
LUMINUS_COMPLETE_TIMEOUT=300
